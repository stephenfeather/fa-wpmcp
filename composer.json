{
	"name": "featherart/fa-wpmcp",
	"description": "WordPress plugin that exposes WordPress functionality to AI agents via Abilities API and MCP Adapter",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Feather Art",
			"email": "contact@featherart.com"
		}
	],
	"require": {
		"php": ">=8.1",
		"wordpress/abilities-api": "^0.5",
		"wordpress/mcp-adapter": "^0.4",
		"woocommerce/action-scheduler": "^3.7"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"squizlabs/php_codesniffer": "^3.8",
		"wp-coding-standards/wpcs": "^3.0",
		"phpstan/phpstan": "^1.10"
	},
	"autoload": {
		"psr-4": {
			"FAWpmcp\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"FAWpmcp\\Tests\\": "tests/phpunit/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:coverage": "phpunit --coverage-html tests/coverage",
		"phpcs": "phpcs --standard=.phpcs.xml",
		"phpcbf": "phpcbf --standard=.phpcs.xml",
		"phpstan": "phpstan analyse --memory-limit=1G"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"minimum-stability": "RC",
	"prefer-stable": true
}
