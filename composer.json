{
  "name": "stephenfeather/fa-wpmcp",
  "description": "WordPress plugin that exposes WordPress functionality to AI agents via Abilities API and MCP Adapter",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Stephen Feather",
      "email": "sfeather@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "wordpress/mcp-adapter": "^0.4",
    "woocommerce/action-scheduler": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "squizlabs/php_codesniffer": "^3.8",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan": "^1.10",
    "hamcrest/hamcrest-php": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "FAWpmcp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FAWpmcp\\Tests\\": "tests/phpunit/",
      "FAWpmcp\\Tests\\Integration\\": "tests/integration/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testsuite=unit",
    "test:unit": "vendor/bin/phpunit --testsuite=unit",
    "test:integration": "vendor/bin/phpunit --testsuite=integration --bootstrap=tests/integration/bootstrap.php --no-coverage",
    "test:coverage": "vendor/bin/phpunit --testsuite=unit --coverage-html tests/coverage",
    "test:all": "vendor/bin/phpunit --bootstrap=tests/integration/bootstrap.php",
    "docker:up": "docker-compose -f docker/docker-compose.test.yml up -d --build",
    "docker:down": "docker-compose -f docker/docker-compose.test.yml down",
    "docker:clean": "docker-compose -f docker/docker-compose.test.yml down -v --remove-orphans",
    "docker:logs": "docker-compose -f docker/docker-compose.test.yml logs -f",
    "docker:test": [
      "@docker:up",
      "@test:integration"
    ],
    "phpcs": "vendor/bin/phpcs --standard=.phpcs.xml",
    "phpcbf": "vendor/bin/phpcbf --standard=.phpcs.xml",
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
